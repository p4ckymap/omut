{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "omut",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5186
    },
    {
      "name": "omut-concept",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5173",
        "--directory",
        "concept"
      ],
      "port": 5173
    },
    {
      "name": "omut-pages-test",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4180",
        "--directory",
        "output/pages-test"
      ],
      "port": 4180
    }
  ]
}