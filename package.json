{
  "name": "omut",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5186 --strictPort",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test": "npm run test:engine && npm run test:layout",
    "test:engine": "vitest run --exclude tests/engine/simulation.test.ts",
    "test:layout": "playwright test",
    "simulate": "vitest run tests/engine/simulation.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "art": "node scripts/art.mjs"
  },
  "dependencies": {
    "@fontsource/golos-text": "5.3.0",
    "@fontsource/ruslan-display": "5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
